# Copy to .env and fill in. Never commit .env.
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wedding_invitation

# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OAuth client id (Web application) from Google Cloud Console; leave empty to turn Google sign-in off
GOOGLE_CLIENT_ID=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# npm run seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=daffa.alvina@example.com
SEED_OWNER_PASSWORD=
