{
  "name": "wedding-invitation-api",
  "version": "0.1.0",
  "private": true,
  "description": "Express + MongoDB API for the wedding invitation platform: login, owners, invitations, attendees.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
